# Private, required when MongoDB is consumed. A new local server and database.
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=whatmeal
# Private, required when authentication is consumed. Generate your own value.
AUTH_SECRET=
# Optional, local Auth.js URL. Never reuse production cookies or secrets.
AUTH_URL=http://localhost:3000
# Public, optional. Notifications are disabled by default.
NEXT_PUBLIC_NOTIFICATIONS_ENABLED=false
# Optional Firebase configuration belongs to the notifications quest.
# Do not reuse the former project's credentials.
